# Authentication
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-secure-password
ADMIN_EMAIL=admin@authronic.com
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Database & Storage (Phase 2)
DATABASE_URL=postgresql://postgres:password@localhost:5432/authronic_command_center
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# AI (Phase 3+)
OPENROUTER_API_KEY=sk-or-...

# n8n Integration (Phase 5)
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_SECRET=generate-a-secret-for-hmac

# App
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development
